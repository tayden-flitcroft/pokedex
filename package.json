{
  "name": "pokedex",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests *.json *.ts *.md .github/workflows/*.yml compose.yaml",
    "format:check": "prettier --check src tests *.json *.ts *.md .github/workflows/*.yml compose.yaml"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
